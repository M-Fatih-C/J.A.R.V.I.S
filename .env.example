# ── App ──────────────────────────────────────────────
APP_NAME=Jarvis
ENV=dev                      # dev | prod
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Ollama ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Agent ────────────────────────────────────────────
# Agent'ın dosya/shell/kod araçlarının hapsedileceği çalışma dizini
AGENT_WORKDIR=./data/workspace

# ── Voice ────────────────────────────────────────────
STT_MODEL=mlx-community/whisper-large-v3-turbo
TTS_VOICE=Yelda                # macOS 'say' Türkçe sesi
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ─────────────────────────────────────────
CHROMA_PATH=./data/chroma

# ── SQLite ───────────────────────────────────────────
SQLITE_PATH=./data/jarvis.db
SQLITE_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

# ── Security ─────────────────────────────────────────
JWT_SECRET=change-me-please
JWT_ALGORITHM=HS256
